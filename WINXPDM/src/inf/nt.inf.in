; WINXPDM QEMU Standard VGA display miniport and GDI driver
[Version]
Signature="$Windows NT$"
Provider=%Provider%
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Class=Display
DriverVer=11/20/2026,0.9.0.0

[Manufacturer]
%Provider%=Models@DECORATION@

[Models@ARCH@]
%Device%=Adapter,PCI\VEN_1234&DEV_1111

[Adapter]
CopyFiles=Miniport,DisplayDLL

[DestinationDirs]
Miniport=12
DisplayDLL=11

[Miniport]
wxpdm.sys

[DisplayDLL]
wxpdm.dll

[Adapter.Services]
AddService=wxpdm,0x00000002,Service

[Service]
ServiceType=1
StartType=1
ErrorControl=1
LoadOrderGroup=Video
ServiceBinary=%12%\wxpdm.sys

[Adapter.SoftwareSettings]
AddReg=Settings

[Settings]
HKR,,InstalledDisplayDrivers,0x00010000,wxpdm
HKR,,VgaCompatible,0x00010001,0
HKR,,DefaultSettings.BitsPerPel,0x00010001,16
HKR,,DefaultSettings.XResolution,0x00010001,800
HKR,,DefaultSettings.YResolution,0x00010001,600
HKR,,DefaultSettings.VRefresh,0x00010001,60

[Adapter.GeneralConfigData]
MaximumDeviceMemoryConfiguration=128

[SourceDisksNames]
1=%Disk%,,,
[SourceDisksFiles]
wxpdm.sys=1
wxpdm.dll=1

[Strings]
Device="WINXPDM QEMU Standard VGA"
Provider="WINXPDM"
Disk="WINXPDM Display Driver"

#include <windows.h>
#include "ui.h"

ID_INFO_ICON ICON "display.ico"
ID_REMOVE_ICON ICON "remove.ico"

ID_WIZARD DIALOG 0, 0, 254, 138
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | DS_SETFONT
CAPTION "WINXPDM Setup"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL "", ID_ART, "WXPArt", WS_CHILD | WS_VISIBLE, 0, 0, 66, 112
    LTEXT "", ID_TITLE, 76, 11, 171, 15
    LTEXT "", ID_BODY, 76, 34, 170, 74
    CONTROL "Keep my display driver and install VirtIO 3D", ID_EXISTING, "BUTTON", WS_CHILD | WS_TABSTOP | BS_AUTOCHECKBOX, 76, 92, 173, 18
    PUSHBUTTON "Test &3D", ID_3D, 92, 118, 53, 14
    PUSHBUTTON "< &Back", ID_BACK, 102, 118, 44, 14
    DEFPUSHBUTTON "&Next >", IDOK, 149, 118, 44, 14
    PUSHBUTTON "Cancel", IDCANCEL, 200, 118, 44, 14
END

[version]
Signature   = "$Windows NT$"
Class       = Net
ClassGUID   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %Msft%
LayoutFile  = layout.inf
DriverVer=10/19/1999,5.366.818.1999

[Manufacturer]
%Realtek%   = Realtek
%ATI%       = ATI
%ACCTON%    = ACCTON  
%ACER%      = ACER  
%CIS%       = CIS     
%D-Link%    = D-Link  
%EDIMAX%    = EDIMAX  
%KATRON%    = KATRON
%KINGSTON%  = KINGSTON
%KYE%	    = KYE
%OVISLINK%  = OVISLINK
%RUBYTECH%  = RUBYTECH     
%SMC%       = SMC     
%SURECOM%   = SURECOM     
%UNEX%	    = UNEX

[ControlFlags]
ExcludeFromSelect     = PCI\VEN_10EC&DEV_8139, \
                        PCI\VEN_1113&DEV_1211, \
                        PCI\VEN_10EC&DEV_8139&SUBSYS_25001259, \
                        PCI\VEN_10EC&DEV_8139&SUBSYS_00012646, \
                        PCI\VEN_10EC&DEV_8139&SUBSYS_91301432, \
                        PCI\VEN_10EC&DEV_8139&SUBSYS_81391436, \
                        PCI\VEN_10EC&DEV_8139&SUBSYS_13201186, \
                        PCI\VEN_10EC&DEV_8139&SUBSYS_60011489, \
                        PCI\VEN_10EC&DEV_8139&SUBSYS_60021489, \
                        PCI\VEN_10EC&DEV_8139&SUBSYS_D0101429, \
                        PCI\VEN_10EC&DEV_8139&SUBSYS_89201025, \
                        PCI\VEN_10EC&DEV_8139&SUBSYS_89211025, \
                        PCI\VEN_10EC&DEV_8139&SUBSYS_1439146C, \
                        PCI\VEN_10EC&DEV_8139&SUBSYS_032010BD, \
                        PCI\VEN_10EC&DEV_8139&SUBSYS_71008E2E, \
                        PCI\VEN_10EC&DEV_8139&SUBSYS_70008E2E, \
                        PCI\VEN_10EC&DEV_8139&SUBSYS_8139149C, \
                        PCI\VEN_10EC&DEV_8139&SUBSYS_139A149C, \
                        PCI\VEN_1113&DEV_1211&SUBSYS_12111113, \
                        PCI\VEN_1113&DEV_1211&SUBSYS_1207103C, \
                        PCI\VEN_1113&DEV_1211&SUBSYS_92111113, \
                        PCI\VEN_10EC&DEV_8139&SUBSYS_813910EC

[Realtek]
%RTL8139.DeviceDesc%  = RTL8139.ndi, PCI\VEN_10EC&DEV_8139
%RTL8139.DeviceDesc%  = RTL8139.ndi, PCI\VEN_1113&DEV_1211
%Realtek.DeviceDesc%  = RTL8139.ndi, PCI\VEN_10EC&DEV_8139&SUBSYS_813910EC

[ATI]
%AT2500.DeviceDesc%   = RTL8139.ndi, PCI\VEN_10EC&DEV_8139&SUBSYS_25001259

[ACCTON]  
%EN1207D.DeviceDesc%  =	RTL8139.ndi, PCI\VEN_1113&DEV_1211&SUBSYS_92111113

[ACER]  
%ALN3251.DeviceDesc%  =	RTL8139.ndi, PCI\VEN_10EC&DEV_8139&SUBSYS_89201025
%ALN3252.DeviceDesc%  =	RTL8139.ndi, PCI\VEN_10EC&DEV_8139&SUBSYS_89211025

[CIS]     
%WSR420.DeviceDesc%   =	RTL8139.ndi, PCI\VEN_10EC&DEV_8139&SUBSYS_81391436

[D-Link]  
%SN5200.DeviceDesc%   =	RTL8139.ndi, PCI\VEN_10EC&DEV_8139&SUBSYS_13201186

[EDIMAX]  
%EN9130TX.DeviceDesc% =	RTL8139.ndi, PCI\VEN_10EC&DEV_8139&SUBSYS_91301432

[KATRON]
%KF2301.DeviceDesc%   =	RTL8139.ndi, PCI\VEN_10EC&DEV_8139&SUBSYS_71008E2E
%KF2302.DeviceDesc%   =	RTL8139.ndi, PCI\VEN_10EC&DEV_8139&SUBSYS_70008E2E

[KINGSTON]
%KNE120TX.DeviceDesc% =	RTL8139.ndi, PCI\VEN_10EC&DEV_8139&SUBSYS_00012646

[KYE]
%GF100TX1.DeviceDesc% =	RTL8139.ndi, PCI\VEN_10EC&DEV_8139&SUBSYS_60011489
%GF100TX2.DeviceDesc% =	RTL8139.ndi, PCI\VEN_10EC&DEV_8139&SUBSYS_60021489

[OVISLINK]
%LFE8139.DeviceDesc%  =	RTL8139.ndi, PCI\VEN_10EC&DEV_8139&SUBSYS_8139149C
%LFE8139A.DeviceDesc% =	RTL8139.ndi, PCI\VEN_10EC&DEV_8139&SUBSYS_139A149C

[RUBYTECH]
%FE1439.DeviceDesc%   =	RTL8139.ndi, PCI\VEN_10EC&DEV_8139&SUBSYS_1439146C

[SMC]     
%SMC1211.DeviceDesc%  =	RTL8139.ndi, PCI\VEN_1113&DEV_1211&SUBSYS_12111113

[SURECOM]
%EP320X.DeviceDesc%   =	RTL8139.ndi, PCI\VEN_10EC&DEV_8139&SUBSYS_032010BD

[UNEX]     
%ND010.DeviceDesc%    =	RTL8139.ndi, PCI\VEN_10EC&DEV_8139&SUBSYS_D0101429


;-------------------------------------------------------------------------------
; RTL8139 Common
; 
[RTL8139.ndi]
AddReg          = RTL8139.speed.reg, RTL8139.reg
Characteristics = 0x84
BusType         = 5
CopyFiles       = RTL8139.CopyFiles

[RTL8139.ndi.Services]
AddService = rtl8139, 2, rtsnt.Service, RTL8139.EventLog

[RTL8139.CopyFiles]
RTL8139.sys,,,2

;-------------------------------------------------------------------------------
; RTL8139 Parameters
; 
[RTL8139.speed.reg]
HKR, Ndi\params\DuplexMode,      ParamDesc, 0, %DuplexMode% 
HKR, Ndi\params\DuplexMode,      type,      0, "enum"
HKR, Ndi\params\DuplexMode,      default,   0, "1"
;HKR, Ndi\params\DuplexMode,      default,   0, "0"
;HKR, Ndi\params\DuplexMode\enum, 0,         0, %dmDefault%
HKR, Ndi\params\DuplexMode\enum, 1,         0, %dmAutoMode% 
HKR, Ndi\params\DuplexMode\enum, 2,         0, %dm10HalfMode% 
HKR, Ndi\params\DuplexMode\enum, 3,         0, %dm10FullMode% 
HKR, Ndi\params\DuplexMode\enum, 4,         0, %dm100HalfMode%
HKR, Ndi\params\DuplexMode\enum, 5,         0, %dm100FullMode%

; networkaddress
HKR, NDI\params\networkaddress,             ParamDesc,      0, %networkaddress%
HKR, NDI\params\networkaddress,             type,           0, "edit"
HKR, NDI\params\networkaddress,             LimitText,      0, "12"
HKR, NDI\params\networkaddress,             UpperCase,      0, "1"
HKR, NDI\params\networkaddress,             default,        0, " "
HKR, NDI\params\networkaddress,             optional,       0, "1"

;-------------------------------------------------------------------------------
; RTL8139 Common
; 
[RTL8139.reg]
HKR, Ndi\Interfaces,            UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces,            LowerRange, 0, "ethernet"
HKR, Ndi,                       Service,    0, "RTL8139"

[rtsnt.Service]
DisplayName     = %RTL8139.Service.DispName%
ServiceType     = 1 ;%SERVICE_KERNEL_DRIVER%
StartType       = 3 ;%SERVICE_DEMAND_START%
ErrorControl    = 1 ;%SERVICE_ERROR_NORMAL%
ServiceBinary   = %12%\RTL8139.SYS
LoadOrderGroup  = NDIS

[RTL8139.EventLog]
Addreg = RTL8139.AddEventLog.reg

[RTL8139.AddEventLog.reg]
HKR,    ,   EventMessageFile,   0x00020000, "%%SystemRoot%%\System32\netevent.dll"
HKR,    ,   TypesSupported,     0x00010001, 7

[DestinationDirs]
RTL8139.CopyFiles = 12

[Strings]
Msft                      = "Microsoft"
Realtek                   = "Realtek"
ATI                       = "Allied Telesyn"
ACCTON                    = "ACCTON"  
ACER                      = "ACER"
CIS                       = "CIS"     
D-Link                    = "D-Link"  
EDIMAX                    = "EDIMAX"  
KATRON                    = "KATRON"
KINGSTON                  = "KINGSTON"
KYE                       = "KYE"
OVISLINK                  = "OVISLINK"
RUBYTECH                  = "RUBYTECH"
SMC                       = "SMC"     
SURECOM                   = "SURECOM"
UNEX                      = "UNEX"

DuplexMode                = "Link Speed/Duplex Mode"
;dmDefault                = "Default"
dmAutoMode                = "Auto Mode"
dm10HalfMode              = "10 Half Mode"
dm10FullMode              = "10 Full Mode"
dm100HalfMode             = "100 Half Mode"
dm100FullMode             = "100 Full Mode"
NetworkAddress            = "Network Address"


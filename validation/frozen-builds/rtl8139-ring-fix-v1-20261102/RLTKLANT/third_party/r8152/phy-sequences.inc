			     GPHY_STS_MSK | SPEED_DOWN_MSK | SPDWN_RXDV_MSK |
			     SPDWN_LINKCHG_MSK);
	if (ret < 0)
		goto out;

	ret = ocp_word_set_bits(tp, MCU_TYPE_USB, USB_USB_TIMER, BIT(15));
	if (ret < 0)
		goto out;

	/* MSC timer = 8s */
	ret = ocp_write_word(tp, MCU_TYPE_USB, USB_MSC_TIMER, 8000 / 8);
	if (ret < 0)
		goto out;


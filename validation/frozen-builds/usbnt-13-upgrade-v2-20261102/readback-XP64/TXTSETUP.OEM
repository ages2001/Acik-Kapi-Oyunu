; TXTSETUP.OEM - USBNT driver disk - Windows XP / 2003 x64 (generated by build/mkinf.py)
;
; Press F6 when setup starts, then S at "Setup could not determine the type of
;   one or more mass storage devices", insert this disk and choose an entry.
;   "USB 3 xHCI, USB4, card readers": Windows keeps its own drivers for
;   USB 1.1 / 2.0 controllers; "every USB controller": USBNT drives them all.
; nLite and similar tools: point them at USBNT.INF (or this file) in this folder.
;
; Every file is in the root of the disk (the folder of this file).

[Disks]
d1 = "USBNT driver disk - Windows XP / 2003 x64", \usbnt.tag, \

[Defaults]
scsi = usbnt64

[scsi]
usbnt64  = "USBNT - Windows XP / 2003 x64: USB 3 xHCI, USB4, readers", usbnt
usbnt64a = "USBNT - Windows XP / 2003 x64: every USB controller", usbnt

[Files.scsi.usbnt64]
driver = d1, usbnt.sys, usbnt
inf    = d1, usbnt.inf
inf    = d1, usbntkbd.inf
inf    = d1, usbntmou.inf

[Files.scsi.usbnt64a]
driver = d1, usbnt.sys, usbnt
inf    = d1, usbnt.inf
inf    = d1, usbntkbd.inf
inf    = d1, usbntmou.inf

[HardwareIds.scsi.usbnt64]

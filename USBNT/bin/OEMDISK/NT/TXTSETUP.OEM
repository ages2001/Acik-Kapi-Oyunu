; TXTSETUP.OEM - USBNT driver disk - Windows NT 3.1 to 4.0 (generated by build/mkinf.py)
;
; Windows NT 3.1, 3.5, 3.51, 4.0: at the mass storage screen press S, choose
;   "Other", insert this disk and choose "USBNT - Windows NT 3.1 to 4.0".
;
; Every file is in the root of the disk (the folder of this file).

[Disks]
d1 = "USBNT driver disk - Windows NT 3.1 to 4.0", \usbnt.tag, \

[Defaults]
scsi = usbntnt

[scsi]
usbntnt  = "USBNT - Windows NT 3.1 to 4.0", usbnt

[Files.scsi.usbntnt]
driver = d1, usbnt.sys, usbnt

; usbnt.sys reads its parameters from Services\usbnt\Parameters (README.md);
; OemSetup tells usbinst that text-mode setup installed the driver
[Config.usbnt]
value = Parameters, OemSetup, REG_DWORD, 1

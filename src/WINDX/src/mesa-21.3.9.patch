 /*-------------------- 7.25.4 Mutex functions --------------------*/
+static inline int
+impl_mtx_acquire(mtx_t *mtx, DWORD timeout)
+{
+    HANDLE handle = mtx->handle;
+    if (!handle) {
+        HANDLE candidate = CreateMutexA(NULL, FALSE, NULL);
+        if (!candidate)
+            return thrd_nomem;
+        handle = InterlockedCompareExchangePointer(&mtx->handle, candidate, NULL);
+        if (handle)
+            CloseHandle(candidate);
+        else
+            handle = candidate;
+    }
+    DWORD result = WaitForSingleObject(handle, timeout);
+    if (result == WAIT_OBJECT_0 || result == WAIT_ABANDONED)
+        return thrd_success;
+    return result == WAIT_TIMEOUT ? thrd_busy : thrd_error;
+}

+/* Retained-mode frames act on row vectors. Each frame stores its transform
+ * relative to its parent. All three public versions share this representation. */
+static void frame_multiply(D3DRMMATRIX4D out, const D3DRMMATRIX4D first, const D3DRMMATRIX4D second)
+{
+    D3DRMMATRIX4D result;
+    unsigned int r, c, k;
+    for (r = 0; r < 4; ++r)
+        for (c = 0; c < 4; ++c)
+        {
+            result[r][c] = 0.0f;
+            for (k = 0; k < 4; ++k) result[r][c] += first[r][k] * second[k][c];
+        }
+    memcpy(out, result, sizeof(result));
+}
+
+static void frame_world_matrix(const struct d3drm_frame *frame, D3DRMMATRIX4D result)
+{
+    memcpy(result, frame->transform, sizeof(D3DRMMATRIX4D));
+    while ((frame = frame->parent)) frame_multiply(result, result, frame->transform);
+}
+
+static void frame_transform_point(const D3DRMMATRIX4D m, D3DVECTOR *out, const D3DVECTOR *v)
+{
+    const float x = v->u1.x, y = v->u2.y, z = v->u3.z;
+    out->u1.x = x * m[0][0] + y * m[1][0] + z * m[2][0] + m[3][0];
+    out->u2.y = x * m[0][1] + y * m[1][1] + z * m[2][1] + m[3][1];
+    out->u3.z = x * m[0][2] + y * m[1][2] + z * m[2][2] + m[3][2];
+}
+
+static BOOL frame_inverse_affine(const D3DRMMATRIX4D m, D3DRMMATRIX4D inv)
+{
+    unsigned int r, c;
+    double cof[3][3], det;
+    for (r = 0; r < 3; ++r)
+        for (c = 0; c < 3; ++c)
+        {
+            unsigned int r1 = (r + 1) % 3, r2 = (r + 2) % 3;
+            unsigned int c1 = (c + 1) % 3, c2 = (c + 2) % 3;
+            cof[r][c] = (double)m[r1][c1] * m[r2][c2] - (double)m[r1][c2] * m[r2][c1];
+        }
+    det = m[0][0] * cof[0][0] + m[0][1] * cof[0][1] + m[0][2] * cof[0][2];
+    if (det == 0.0) return FALSE;
+    for (c = 0; c < 3; ++c)
+    {
+        for (r = 0; r < 3; ++r) inv[r][c] = cof[c][r] / det;
+        inv[3][c] = -(m[3][0] * inv[0][c] + m[3][1] * inv[1][c] + m[3][2] * inv[2][c]);
+        inv[c][3] = 0.0f;
+    }
+    inv[3][3] = 1.0f;
+    return TRUE;
+}

+/* NT 3.x has a USER export with the same name as the later multi-monitor
+ * API but a different calling convention and parameter layout. */
+static void adapter_name(UINT ordinal, WCHAR *name)
+{
+    DWORD version = GetVersion();
+    HMODULE user = GetModuleHandleA("user32.dll");
+    if (version & 0x80000000u)
+    {
+        DISPLAY_DEVICEA dev;
+        BOOL (WINAPI *enumerate)(const char *, DWORD, DISPLAY_DEVICEA *, DWORD)
+                = (void *)GetProcAddress(user, "EnumDisplayDevicesA");
+        memset(&dev, 0, sizeof(dev));
+        dev.cb = sizeof(dev);
+        if (HIBYTE(LOWORD(version)) >= 10 && enumerate && enumerate(NULL, ordinal, &dev, 0)
+                && dev.DeviceName[0] && MultiByteToWideChar(CP_ACP, 0, dev.DeviceName, -1, name, CCHDEVICENAME))
+            return;
+    }
+    else if (LOBYTE(LOWORD(version)) >= 5)
+    {
+        DISPLAY_DEVICEW dev;
+        BOOL (WINAPI *enumerate)(const WCHAR *, DWORD, DISPLAY_DEVICEW *, DWORD)
+                = (void *)GetProcAddress(user, "EnumDisplayDevicesW");
+        memset(&dev, 0, sizeof(dev));
+        dev.cb = sizeof(dev);
+        if (enumerate && enumerate(NULL, ordinal, &dev, 0) && dev.DeviceName[0])
+        {
+            memcpy(name, dev.DeviceName, sizeof(dev.DeviceName));
+            name[CCHDEVICENAME - 1] = 0;
+            return;
+        }
+    }
+    MultiByteToWideChar(CP_ACP, 0, "\\\\.\\DISPLAY1", -1, name, CCHDEVICENAME);
+}

+static HRESULT add_hardware_text(IDxDiagContainerImpl_Container *node, const WCHAR *property, const char *str)
+{
+    WCHAR wide[384];
+    if (!MultiByteToWideChar(CP_ACP, 0, str, -1, wide, sizeof(wide) / sizeof(*wide)))
+        return HRESULT_FROM_WIN32(GetLastError());
+    return add_bstr_property(node, property, wide);
+}
+
+static BOOL diagnostic_file_version(const char *path, char *out)
+{
+    DWORD ignored, bytes = GetFileVersionInfoSizeA(path, &ignored);
+    UINT count;
+    VS_FIXEDFILEINFO *version;
+    BYTE *buffer;
+    BOOL success = FALSE;
+    if (!bytes || !(buffer = HeapAlloc(GetProcessHeap(), 0, bytes))) return FALSE;
+    if (GetFileVersionInfoA(path, 0, bytes, buffer) &&
+            VerQueryValueA(buffer, "\\", (void **)&version, &count) && count >= sizeof(*version) &&
+            version->dwSignature == VS_FFI_SIGNATURE) {
+        wsprintfA(out, "%u.%02u.%u.%04u", HIWORD(version->dwFileVersionMS),
+                LOWORD(version->dwFileVersionMS), HIWORD(version->dwFileVersionLS), LOWORD(version->dwFileVersionLS));
+        success = TRUE;
+    }
+    HeapFree(GetProcessHeap(), 0, buffer);
+    return success;
+}
+
+static HRESULT fill_dxdiag_version(IDxDiagContainerImpl_Container *node, const WCHAR *property)
+{
+    char file[MAX_PATH], version[64];
+    DWORD length = GetModuleFileNameA(NULL, file, sizeof(file));
+    char *p, *base = file;
+    if (length && length < sizeof(file)) {
+        for (p = file; *p; ++p) if (*p == '\\' || *p == '/') base = p + 1;
+        if (!lstrcmpiA(base, "dxdiag.exe") && diagnostic_file_version(file, version))
+            return add_hardware_text(node, property, version);
+    }
+    length = GetModuleFileNameA(dxdiagn_instance, file, sizeof(file));
+    if (length && length < sizeof(file)) {
+        for (base = p = file; *p; ++p) if (*p == '\\' || *p == '/') base = p + 1;
+        if (sizeof(file) - (base - file) >= sizeof("dxdiag.exe")) {
+            lstrcpyA(base, "dxdiag.exe");
+            if (diagnostic_file_version(file, version)) return add_hardware_text(node, property, version);
+        }
+    }
+    length = GetSystemDirectoryA(file, sizeof(file));
+    if (length && length < sizeof(file) - sizeof("\\dxdiag.exe")) {
+        lstrcatA(file, "\\dxdiag.exe");
+        if (diagnostic_file_version(file, version)) return add_hardware_text(node, property, version);
+    }
+    return add_hardware_text(node, property, "DxDiag executable version unavailable");
+}

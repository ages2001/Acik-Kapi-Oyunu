+static void wined3d_surface_sync_dc(struct wined3d_surface *surface, BOOL writeback)
+{
+    unsigned int y;
+    if (!surface->mapped_pixels || !surface->dib_pixels)
+        return;
+    if (writeback)
+        GdiFlush();
+    for (y = 0; y < surface->dib_height; ++y)
+    {
+        BYTE *bits = surface->dib_pixels + (SIZE_T)y * surface->dib_pitch;
+        BYTE *texture = surface->mapped_pixels + (SIZE_T)y * surface->mapped_pitch;
+        if (writeback) memcpy(texture, bits, surface->row_bytes);
+        else memcpy(bits, texture, surface->row_bytes);
+    }
+}

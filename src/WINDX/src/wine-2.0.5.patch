+static BOOL adapter_allocate_luid(UINT ordinal, LUID *luid)
+{
+    char name[48];
+    ATOM atom;
+
+    if (!(GetVersion() & 0x80000000u))
+        return AllocateLocallyUniqueId(luid);
+
+    /* The 9x security DLL exports AllocateLocallyUniqueId but cannot allocate
+     * one. Share one adapter identity across clients using the session-global
+     * atom table. Keep the atom alive until Windows ends the session. */
+    wsprintfA(name, "WINDX_DXGI_Adapter_%u", ordinal);
+    if (!(atom = GlobalFindAtomA(name)) && !(atom = GlobalAddAtomA(name)))
+        return FALSE;
+    luid->HighPart = 0x57445800;
+    luid->LowPart = atom;
+    return TRUE;
+}

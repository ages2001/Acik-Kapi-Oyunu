+static inline int windx_describe_pixel_format(HDC dc, int format, UINT size, PIXELFORMATDESCRIPTOR *pfd)
+{
+    int (WINAPI *describe)(HDC, int, UINT, PIXELFORMATDESCRIPTOR *) = (void *)
+            GetProcAddress(GetModuleHandleA("opengl32.dll"), "wglDescribePixelFormat");
+    return describe ? describe(dc, format, size, pfd) : DescribePixelFormat(dc, format, size, pfd);

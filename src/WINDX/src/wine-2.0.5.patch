+    LONG (WINAPI *change_w)(DEVMODEW *, DWORD);
+    LONG (WINAPI *change_ex_a)(const char *, DEVMODEA *, HWND, DWORD, void *);
+    LONG (WINAPI *change_a)(DEVMODEA *, DWORD);
+    DEVMODEA ansi;
+    char name[CCHDEVICENAME];
+    const char *selected = NULL;
+
+    if (!(GetVersion() & 0x80000000u))
+    {
+        change_ex_w = (void *)GetProcAddress(user, "ChangeDisplaySettingsExW");
+        if (change_ex_w) return change_ex_w(device, mode, NULL, CDS_FULLSCREEN, NULL);
+        change_w = (void *)GetProcAddress(user, "ChangeDisplaySettingsW");
+        if (change_w) return change_w(mode, CDS_FULLSCREEN);
+    }
+    if (device && WideCharToMultiByte(CP_ACP, 0, device, -1, name, sizeof(name), NULL, NULL))
+        selected = name;
+    memset(&ansi, 0, sizeof(ansi));
+    ansi.dmSize = sizeof(ansi);
+    ansi.dmFields = mode->dmFields;
+    ansi.dmPelsWidth = mode->dmPelsWidth;
+    ansi.dmPelsHeight = mode->dmPelsHeight;
+    ansi.dmBitsPerPel = mode->dmBitsPerPel;
+    ansi.u2.dmDisplayFlags = mode->u2.dmDisplayFlags;
+    ansi.dmDisplayFrequency = mode->dmDisplayFrequency;
+    change_ex_a = (void *)GetProcAddress(user, "ChangeDisplaySettingsExA");
+    if (change_ex_a) return change_ex_a(selected, &ansi, NULL, CDS_FULLSCREEN, NULL);
+    change_a = (void *)GetProcAddress(user, "ChangeDisplaySettingsA");
+    return change_a ? change_a(&ansi, CDS_FULLSCREEN) : DISP_CHANGE_FAILED;
+}

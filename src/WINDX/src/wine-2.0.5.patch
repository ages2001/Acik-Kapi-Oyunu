+    PIXELFORMATDESCRIPTOR description;
+    BOOL (WINAPI *set)(HDC, int, const PIXELFORMATDESCRIPTOR *) = (void *)
+            GetProcAddress(GetModuleHandleA("opengl32.dll"), "wglSetPixelFormat");
+    if (!pfd && windx_describe_pixel_format(dc, format, sizeof(description), &description))
+        pfd = &description;

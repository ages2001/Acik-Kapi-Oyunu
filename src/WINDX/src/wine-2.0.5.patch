+/* Windows versions with one display expose the original display-mode calls.
+ * Win9x also needs the ANSI entry points for DEVMODE. */
+static HMONITOR adapter_monitor(POINT position)
+{
+    HMONITOR (WINAPI *lookup)(POINT, DWORD) = (void *)
+            GetProcAddress(GetModuleHandleA("user32.dll"), "MonitorFromPoint");
+    /* Primary monitor handle from the Win32 SDK's single-monitor fallback. */
+    return lookup ? lookup(position, MONITOR_DEFAULTTOPRIMARY) : (HMONITOR)(ULONG_PTR)0x12340042;
+}
+
+static BOOL adapter_enum_mode(const WCHAR *device, DWORD index, DEVMODEW *mode)
+{
+    HMODULE user = GetModuleHandleA("user32.dll");
+    DEVMODEA ansi;
+    BOOL (WINAPI *enum_ex_w)(const WCHAR *, DWORD, DEVMODEW *, DWORD);
+    BOOL (WINAPI *enum_w)(const WCHAR *, DWORD, DEVMODEW *);
+    BOOL (WINAPI *enum_ex_a)(const char *, DWORD, DEVMODEA *, DWORD);
+    BOOL (WINAPI *enum_a)(const char *, DWORD, DEVMODEA *);
+    char name[CCHDEVICENAME];
+    const char *selected = NULL;
+    BOOL result;
+
+    if (!(GetVersion() & 0x80000000u))
+    {
+        enum_ex_w = (void *)GetProcAddress(user, "EnumDisplaySettingsExW");
+        if (enum_ex_w) return enum_ex_w(device, index, mode, 0);
+        enum_w = (void *)GetProcAddress(user, "EnumDisplaySettingsW");
+        if (enum_w) return enum_w(NULL, index, mode);
+    }
+    if (device && WideCharToMultiByte(CP_ACP, 0, device, -1, name, sizeof(name), NULL, NULL))
+        selected = name;
+    memset(&ansi, 0, sizeof(ansi));
+    ansi.dmSize = sizeof(ansi);
+    enum_ex_a = (void *)GetProcAddress(user, "EnumDisplaySettingsExA");
+    enum_a = (void *)GetProcAddress(user, "EnumDisplaySettingsA");
+    result = enum_ex_a ? enum_ex_a(selected, index, &ansi, 0) : (enum_a && enum_a(NULL, index, &ansi));
+    if (!result) return FALSE;
+    mode->dmFields = ansi.dmFields;
+    mode->dmPelsWidth = ansi.dmPelsWidth;
+    mode->dmPelsHeight = ansi.dmPelsHeight;
+    mode->dmBitsPerPel = ansi.dmBitsPerPel;
+    mode->u2.dmDisplayFlags = ansi.u2.dmDisplayFlags;
+    mode->dmDisplayFrequency = ansi.dmDisplayFrequency;
+    mode->u1.s2.dmDisplayOrientation = ansi.u1.s2.dmDisplayOrientation;
+    return TRUE;
+}

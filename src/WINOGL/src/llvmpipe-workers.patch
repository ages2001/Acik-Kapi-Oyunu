+/* Join the workers outside the Windows loader lock. The device and its
+ * disk cache can survive the last context and be reused by a later one. */
+void
+llvmpipe_screen_release_context(struct llvmpipe_screen *screen)
+{
+   struct lp_cs_tpool *compute = NULL;
+   struct lp_rasterizer *rasterizer = NULL;
+
+   mtx_lock(&screen->late_mutex);
+   assert(screen->live_contexts);
+   if (!--screen->live_contexts) {
+      compute = screen->cs_tpool;
+      screen->cs_tpool = NULL;
+      rasterizer = screen->rast;
+      screen->rast = NULL;
+   }
+   mtx_unlock(&screen->late_mutex);
+
+   if (compute)
+      lp_cs_tpool_destroy(compute);
+   if (rasterizer)
+      lp_rast_destroy(rasterizer);
 }
 

[binaries]
c = '@CC@'
cpp = '@CXX@'
ar = '@TRIPLE@-ar'
strip = '@TRIPLE@-strip'
windres = '@TRIPLE@-windres'
pkg-config = 'pkg-config'

[host_machine]
system = 'windows'
cpu_family = '@FAMILY@'
cpu = '@CPU@'
endian = 'little'

[properties]
needs_exe_wrapper = true
pkg_config_libdir = '@PKGDIR@'

[built-in options]
c_args = ['-march=@CPU@']
cpp_args = ['-march=@CPU@']
c_link_args = ['-static-libgcc']
cpp_link_args = ['-static-libgcc', '-static-libstdc++']
